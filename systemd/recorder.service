[Unit]
Description=piRecorder audio recorder
After=sound.target

[Service]
Type=simple
User=jk
WorkingDirectory=/home/jk/recorder
ExecStart=/home/jk/recorder/.venv/bin/python -u /home/jk/recorder/recorder_main.py
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=40

[Install]
WantedBy=multi-user.target
